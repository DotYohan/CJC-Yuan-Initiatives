generator client {
  provider = "prisma-client-js"
}

enum StudentDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  RETURNED_FOR_CORRECTION

  @@map("student_document_status")
}

model DocumentType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  required    Boolean  @default(true)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  documents StudentDocument[]

  @@index([active, sortOrder])
  @@map("document_types")
}

model DocumentVerificationHistory {
  id                BigInt                 @id @default(autoincrement()) @db.BigInt
  documentId        String                 @map("document_id") @db.Uuid
  previousStatus    StudentDocumentStatus? @map("previous_status")
  newStatus         StudentDocumentStatus  @map("new_status")
  action            String                 @db.VarChar(50)
  remarks           String?                @db.Text
  performedByUserId String?                @map("performed_by_user_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  document    StudentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  performedBy User?           @relation("DocumentVerificationsPerformed", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([performedByUserId])
  @@map("document_verification_history")
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("account_status")
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  username             String        @db.VarChar(64)
  usernameNormalized   String        @unique @map("username_normalized") @db.VarChar(64)
  displayName          String        @map("display_name") @db.VarChar(120)
  email                String?       @db.VarChar(254)
  emailNormalized      String?       @unique @map("email_normalized") @db.VarChar(254)
  emailVerifiedAt      DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  passwordHash         String        @map("password_hash") @db.VarChar(255)
  status               AccountStatus @default(ACTIVE)
  mustChangePassword   Boolean       @default(true) @map("must_change_password")
  failedLoginCount     Int           @default(0) @map("failed_login_count")
  lastFailedAt         DateTime?     @map("last_failed_at") @db.Timestamptz(3)
  lockUntil            DateTime?     @map("lock_until") @db.Timestamptz(3)
  authorizationVersion Int           @default(1) @map("authorization_version")
  passwordChangedAt    DateTime?     @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt          DateTime?     @map("last_login_at") @db.Timestamptz(3)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles                      UserRole[]                          @relation("AssignedUserRoles")
  programAssignments             UserProgramAssignment[]
  programAssignmentsCreated      UserProgramAssignment[]             @relation("UserProgramAssignmentCreatedBy")
  departmentAssignments          UserDepartmentAssignment[]
  departmentAssignmentsCreated   UserDepartmentAssignment[]          @relation("UserDepartmentAssignmentCreatedBy")
  roleAssignmentsMade            UserRole[]                          @relation("RoleAssignmentsMade")
  permissionGrantsMade           RolePermission[]                    @relation("PermissionGrantsMade")
  sessions                       Session[]
  passwordResetTokens            PasswordResetToken[]
  loginAttempts                  LoginAttempt[]
  googleAuth                     UserGoogleAuth?
  actorAuditLogs                 AuditLog[]                          @relation("AuditActor")
  targetAuditLogs                AuditLog[]                          @relation("AuditTarget")
  studentProfile                 Student?
  documentsVerified              StudentDocument[]                   @relation("StudentDocumentVerifiedBy")
  documentsUploaded              StudentDocument[]                   @relation("StudentDocumentUploadedBy")
  facultyProfile                 Faculty?
  applicationsSubmitted          AdmissionApplication[]              @relation("ApplicationApplicant")
  applicationDecisions           AdmissionApplication[]              @relation("ApplicationDecisionMaker")
  applicationChanges             AdmissionApplicationStatusHistory[] @relation("ApplicationStatusChangedBy")
  enrollmentApplicationsReviewed EnrollmentApplication[]             @relation("EnrollmentApplicationReviewer")
  programChanges                 ProgramHistory[]                    @relation("ProgramHistoryChangedBy")
  programHeadGrants              ProgramHeadAssignment[]             @relation("ProgramHeadAssignedBy")
  studentStatusChanges           StudentStatusHistory[]              @relation("StudentStatusChangedBy")
  studentProgramGrants           StudentProgramHistory[]             @relation("StudentProgramAssignedBy")
  curriculumGrants               StudentCurriculumAssignment[]       @relation("StudentCurriculumAssignedBy")
  facultyDeptGrants              FacultyDepartmentAssignment[]       @relation("FacultyDepartmentAssignedBy")
  employmentRecords              FacultyEmployment[]                 @relation("FacultyEmploymentRecordedBy")
  enrollmentsProcessed           Enrollment[]                        @relation("EnrollmentProcessedBy")
  enrollmentChanges              EnrollmentStatusHistory[]           @relation("EnrollmentStatusChangedBy")
  enrollmentPeriodsOpened        EnrollmentPeriod[]                  @relation("EnrollmentPeriodOpenedBy")
  enrollmentPeriodsClosed        EnrollmentPeriod[]                  @relation("EnrollmentPeriodClosedBy")
  enrollmentOverrides            EnrollmentItem[]                    @relation("EnrollmentOverrideApprovedBy")
  gradesApproved                 Grade[]                             @relation("GradeApprovedBy")
  gradeChanges                   GradeHistory[]                      @relation("GradeChangedBy")
  clearanceActions               ClearanceItem[]                     @relation("ClearanceActedBy")
  assessmentsCreated             Assessment[]                        @relation("AssessmentCreatedBy")
  invoicesIssued                 Invoice[]                           @relation("InvoiceIssuedBy")
  paymentsRecorded               Payment[]                           @relation("PaymentRecordedBy")
  financialEntries               FinancialTransaction[]              @relation("FinancialEntryRecordedBy")
  obligationsCreated             StudentObligation[]                 @relation("ObligationCreatedBy")
  transactionsVerified           PaymentTransaction[]                @relation("TransactionVerifiedBy")
  receiptsIssued                 Receipt[]                           @relation("ReceiptIssuedBy")
  requestsSubmitted              StudentRequest[]                    @relation("RequestSubmittedBy")
  requestsProcessed              StudentRequest[]                    @relation("RequestProcessedBy")
  requestStatusChanges           StudentRequestStatusHistory[]       @relation("RequestStatusChangedBy")
  documentVerifications          DocumentVerificationHistory[]       @relation("DocumentVerificationsPerformed")
  systemLogs                     SystemLog[]                         @relation("SystemLogUser")
  clubsCreated                   Club[]                              @relation("ClubCreatedBy")
  clubAccount                    Club?                               @relation("ClubAccountUser")
  clubOfficersAssigned           ClubOfficer[]                       @relation("ClubOfficerAssignedBy")
  clubAnnouncementsPosted        ClubAnnouncement[]                  @relation("ClubAnnouncementPostedBy")
  clubDocumentsUploaded          ClubDocument[]                      @relation("ClubDocumentUploadedBy")
  clubClearancesActed            ClubClearance[]                     @relation("ClubClearanceActedBy")
  clubClearanceAudits            ClubClearanceAudit[]                @relation("ClubClearanceAuditedBy")
  collegeAssignments             UserCollegeAssignment[]
  collegeAssignmentsCreated      UserCollegeAssignment[]             @relation("UserCollegeAssignmentCreatedBy")
  academicRecordImportsReviewed AcademicRecordImportRequest[]       @relation("AcademicRecordImportReviewedBy")

  @@index([deletedAt])
  @@map("users")
}

/// Roles are data-driven. The canonical seed must include the system role
/// `{ slug: "faculty", name: "Faculty" }` alongside the existing roles.
model Role {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  landingPath String   @unique @map("landing_path") @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(100)
  description String   @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId           String   @map("user_id") @db.Uuid
  roleId           Int      @map("role_id")
  isPrimary        Boolean  @default(false) @map("is_primary")
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid

  user       User  @relation("AssignedUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssignmentsMade", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@index([userId, isPrimary])
  @@map("user_roles")
}

model RolePermission {
  roleId          Int      @map("role_id")
  permissionId    Int      @map("permission_id")
  grantedAt       DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("PermissionGrantsMade", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([grantedByUserId])
  @@map("role_permissions")
}

model Session {
  // Only the SHA-256 hash is stored. The raw token remains in the cookie.
  tokenHash            String    @id @map("token_hash") @db.Char(64)
  userId               String?   @map("user_id") @db.Uuid
  csrfHash             String    @map("csrf_hash") @db.Char(64)
  authorizationVersion Int?      @map("authorization_version")
  rememberMe           Boolean   @default(false) @map("remember_me")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt           DateTime  @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt        DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt    DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)

  // Nullable because the existing application creates anonymous CSRF sessions.
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  requestedIpHash String    @map("requested_ip_hash") @db.Char(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id             BigInt   @id @default(autoincrement()) @db.BigInt
  userId         String?  @map("user_id") @db.Uuid
  identifierHash String   @map("identifier_hash") @db.Char(64)
  ipHash         String   @map("ip_hash") @db.Char(64)
  outcome        String   @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Attempts for nonexistent identifiers deliberately have no user relation.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ipHash, createdAt])
  @@index([identifierHash, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement()) @db.BigInt
  eventType      String   @map("event_type") @db.VarChar(100)
  outcome        String   @db.VarChar(32)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  targetUserId   String?  @map("target_user_id") @db.Uuid
  identifierHash String?  @map("identifier_hash") @db.Char(64)
  resourceType   String?  @map("resource_type") @db.VarChar(64)
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  requestId      String   @map("request_id") @db.Uuid
  ipHash         String   @map("ip_hash") @db.Char(64)
  method         String   @db.VarChar(12)
  path           String   @db.VarChar(256)
  metadata       Json     @default("{}") @map("metadata_json") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// Supporting model required to preserve persistent authentication throttling.
model RateLimit {
  scopeKey        String   @id @map("scope_key") @db.VarChar(191)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  attemptCount    Int      @default(1) @map("attempt_count")

  @@index([windowStartedAt])
  @@map("rate_limits")
}

// Supporting model required to preserve generic password-reset responses.
model ResetRequest {
  id             BigInt   @id @default(autoincrement()) @db.BigInt
  identifierHash String   @map("identifier_hash") @db.Char(64)
  ipHash         String   @map("ip_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ipHash, createdAt])
  @@index([identifierHash, createdAt])
  @@map("reset_requests")
}

