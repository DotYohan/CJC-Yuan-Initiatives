/// Top-level academic organization. Operational and authentication data must
/// reference this model rather than duplicating a college name or code.
model College {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @db.VarChar(32)
  /// PostgreSQL canonicalization trigger overwrites this from `code`.
  codeNormalized String   @unique @map("code_normalized") @db.VarChar(32)
  name           String   @db.VarChar(200)
  shortName      String?  @map("short_name") @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  departments Department[]
  clubs       Club[]
  userCollegeAssignments UserCollegeAssignment[]

  @@index([isActive])
  @@map("colleges")
}

/// Academic department belonging to exactly one college.
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @map("college_id") @db.Uuid
  code      String   @db.VarChar(32)
  name      String   @db.VarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  college                   College                       @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  programs                  Program[]
  faculty                   Faculty[]
  subjects                  Subject[]
  programHistory            ProgramHistory[]
  facultyAssignments        FacultyDepartmentAssignment[]
  rooms                     Room[]
  userDepartmentAssignments UserDepartmentAssignment[]
  clearanceRequirements     ClearanceRequirement[]
  clubs                     Club[]

  @@unique([collegeId, code])
  @@index([collegeId, isActive])
  @@map("departments")
}

/// Degree, diploma, or certificate program owned by a department.
model Program {
  id             String   @id @default(uuid()) @db.Uuid
  departmentId   String   @map("department_id") @db.Uuid
  code           String   @db.VarChar(32)
  /// PostgreSQL canonicalization trigger overwrites this from `code`.
  codeNormalized String   @unique @map("code_normalized") @db.VarChar(32)
  name           String   @db.VarChar(200)
  credential     String   @db.VarChar(100)
  durationYears  Int      @map("duration_years") @db.SmallInt
  termsPerYear   Int      @default(2) @map("terms_per_year") @db.SmallInt
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  department             Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students               Student[]
  curricula              Curriculum[]
  history                ProgramHistory[]
  headAssignments        ProgramHeadAssignment[]
  applications           AdmissionApplication[]
  studentHistory         StudentProgramHistory[]
  enrollments            Enrollment[]
  enrollmentApplications EnrollmentApplication[]
  classSections          ClassSection[]
  userProgramAssignments UserProgramAssignment[]
  academicRecordImports  AcademicRecordImportRequest[] @relation("AcademicRecordImportTargetProgram")

  @@index([departmentId, isActive])
  @@map("programs")
}

/// Academic profile for a student. The optional one-to-one User link supplies
/// login identity only; student records remain valid without an account.
model Student {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String?       @unique @map("user_id") @db.Uuid
  studentNumber           String        @map("student_number") @db.VarChar(32)
  /// PostgreSQL canonicalization trigger overwrites this from `studentNumber`.
  studentNumberNormalized String        @unique @map("student_number_normalized") @db.VarChar(32)
  programId               String?       @map("program_id") @db.Uuid
  curriculumId            String?       @map("curriculum_id") @db.Uuid
  firstName               String        @map("first_name") @db.VarChar(100)
  middleName              String?       @map("middle_name") @db.VarChar(100)
  lastName                String        @map("last_name") @db.VarChar(100)
  suffix                  String?       @db.VarChar(20)
  dateOfBirth             DateTime?     @map("date_of_birth") @db.Date
  institutionalEmail      String?       @map("institutional_email") @db.VarChar(254)
  admissionYear           Int           @map("admission_year") @db.SmallInt
  currentYearLevel        Int           @default(1) @map("current_year_level") @db.SmallInt
  status                  StudentStatus @default(ACTIVE)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                   User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  program                Program?                      @relation(fields: [programId], references: [id], onDelete: Restrict)
  curriculum             Curriculum?                   @relation(fields: [curriculumId, programId], references: [id, programId], onDelete: Restrict)
  admissionApplications  AdmissionApplication[]
  documents              StudentDocument[]
  programHistory         StudentProgramHistory[]
  curriculumAssignments  StudentCurriculumAssignment[]
  statusHistory          StudentStatusHistory[]
  enrollments            Enrollment[]
  enrollmentApplications EnrollmentApplication[]
  clearances             StudentClearance[]
  assessments            Assessment[]
  payments               Payment[]
  financialTransactions  FinancialTransaction[]
  obligations            StudentObligation[]
  paymentTransactions    PaymentTransaction[]
  requests               StudentRequest[]
  clubMemberships        ClubMember[]
  clubOfficerRoles       ClubOfficer[]
  clubClearances         ClubClearance[]
  clubClearanceAudits    ClubClearanceAudit[]
  academicRecordImports  AcademicRecordImportRequest[]

  @@index([programId, status])
  @@index([curriculumId])
  @@index([lastName, firstName])
  @@map("students")
}

/// Monotonic per-year counters prevent student numbers from being reused.
model StudentNumberSequence {
  admissionYear Int      @id @map("admission_year") @db.SmallInt
  nextNumber    Int      @default(1) @map("next_number")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("student_number_sequences")
}

/// Academic/employment profile for teaching personnel, separate from login identity.
model Faculty {
  id                       String        @id @default(uuid()) @db.Uuid
  userId                   String?       @unique @map("user_id") @db.Uuid
  employeeNumber           String        @map("employee_number") @db.VarChar(32)
  /// PostgreSQL canonicalization trigger overwrites this from `employeeNumber`.
  employeeNumberNormalized String        @unique @map("employee_number_normalized") @db.VarChar(32)
  departmentId             String        @map("department_id") @db.Uuid
  firstName                String        @map("first_name") @db.VarChar(100)
  middleName               String?       @map("middle_name") @db.VarChar(100)
  lastName                 String        @map("last_name") @db.VarChar(100)
  suffix                   String?       @db.VarChar(20)
  institutionalEmail       String?       @map("institutional_email") @db.VarChar(254)
  employmentType           String?       @map("employment_type") @db.VarChar(50)
  academicRank             String?       @map("academic_rank") @db.VarChar(100)
  status                   FacultyStatus @default(ACTIVE)
  hiredAt                  DateTime?     @map("hired_at") @db.Date
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                   User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  department             Department                    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  departmentAssignments  FacultyDepartmentAssignment[]
  specializations        FacultySpecialization[]
  employmentRecords      FacultyEmployment[]
  programHeadAssignments ProgramHeadAssignment[]
  courseAssignments      FacultyCourseAssignment[]
  submittedGrades        Grade[]

  @@index([departmentId, status])
  @@index([lastName, firstName])
  @@map("faculty")
}

/// Reusable course catalog entry. Scheduling and grade models can reference a
/// Subject independently of the curriculum version that requires it.
model Subject {
  id                     String        @id @default(uuid()) @db.Uuid
  departmentId           String        @map("department_id") @db.Uuid
  code                   String        @db.VarChar(32)
  /// PostgreSQL canonicalization trigger overwrites this from `code`.
  codeNormalized         String        @unique @map("code_normalized") @db.VarChar(32)
  title                  String        @db.VarChar(200)
  description            String?       @db.Text
  defaultCreditUnits     Decimal       @map("default_credit_units") @db.Decimal(4, 2)
  defaultLectureHours    Decimal       @default(0) @map("default_lecture_hours") @db.Decimal(4, 2)
  defaultLaboratoryHours Decimal       @default(0) @map("default_laboratory_hours") @db.Decimal(4, 2)
  status                 SubjectStatus @default(ACTIVE)
  isActive               Boolean       @default(true) @map("is_active")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  curriculumItems     CurriculumSubject[]
  requirements        SubjectRequirement[] @relation("SubjectRequirements")
  requiredForSubjects SubjectRequirement[] @relation("RequiredForSubjects")
  courseOfferings     CourseOffering[]

  @@index([departmentId, isActive])
  @@map("subjects")
}

model SubjectRequirement {
  id                String                 @id @default(uuid()) @db.Uuid
  subjectId         String                 @map("subject_id") @db.Uuid
  requiredSubjectId String                 @map("required_subject_id") @db.Uuid
  type              SubjectRequirementType
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  subject         Subject @relation("SubjectRequirements", fields: [subjectId], references: [id], onDelete: Restrict)
  requiredSubject Subject @relation("RequiredForSubjects", fields: [requiredSubjectId], references: [id], onDelete: Restrict)

  @@unique([subjectId, requiredSubjectId, type])
  @@index([requiredSubjectId])
  @@map("subject_requirements")
}

/// Versioned set of academic requirements for one program. PostgreSQL permits
/// only DRAFT -> ACTIVE -> RETIRED and blocks deletion after activation.
model Curriculum {
  id                String           @id @default(uuid()) @db.Uuid
  programId         String           @map("program_id") @db.Uuid
  code              String           @db.VarChar(50)
  name              String           @db.VarChar(200)
  version           Int              @default(1)
  effectiveFromYear Int              @map("effective_from_year") @db.SmallInt
  effectiveToYear   Int?             @map("effective_to_year") @db.SmallInt
  status            CurriculumStatus @default(DRAFT)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  program                Program                       @relation(fields: [programId], references: [id], onDelete: Restrict)
  students               Student[]
  subjects               CurriculumSubject[]
  studentAssignments     StudentCurriculumAssignment[]
  enrollments            Enrollment[]
  enrollmentApplications EnrollmentApplication[]
  classSections          ClassSection[]

  @@unique([programId, code, version])
  @@unique([id, programId])
  @@index([programId, status])
  @@index([effectiveFromYear, effectiveToYear])
  @@map("curricula")
}

/// Normalized curriculum-to-subject relationship with placement and unit data.
model CurriculumSubject {
  id              String                @id @default(uuid()) @db.Uuid
  curriculumId    String                @map("curriculum_id") @db.Uuid
  subjectId       String                @map("subject_id") @db.Uuid
  yearLevel       Int                   @map("year_level") @db.SmallInt
  termNumber      Int                   @map("term_number") @db.SmallInt
  creditUnits     Decimal               @map("credit_units") @db.Decimal(4, 2)
  lectureHours    Decimal               @default(0) @map("lecture_hours") @db.Decimal(4, 2)
  laboratoryHours Decimal               @default(0) @map("laboratory_hours") @db.Decimal(4, 2)
  type            CurriculumSubjectType @default(REQUIRED)
  isRequired      Boolean               @default(true) @map("is_required")
  sortOrder       Int                   @default(0) @map("sort_order")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([curriculumId, subjectId])
  @@index([subjectId])
  @@index([curriculumId, yearLevel, termNumber, sortOrder])
  @@map("curriculum_subjects")
}

/// Calendar container retained permanently for reporting across academic years.
model AcademicYear {
  id        String               @id @default(uuid()) @db.Uuid
  code      String               @unique @db.VarChar(32)
  name      String               @db.VarChar(100)
  startsOn  DateTime             @map("starts_on") @db.Date
  endsOn    DateTime             @map("ends_on") @db.Date
  status    AcademicPeriodStatus @default(PLANNED)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  terms              AcademicTerm[]
  enrollmentPeriods  EnrollmentPeriod[]
  studentObligations StudentObligation[]

  @@index([status, startsOn])
  @@map("academic_years")
}

/// A semester, trimester, or other enrollment-bearing term within an academic year.
model AcademicTerm {
  id               String               @id @default(uuid()) @db.Uuid
  academicYearId   String               @map("academic_year_id") @db.Uuid
  code             String               @unique @db.VarChar(32)
  name             String               @db.VarChar(100)
  termNumber       Int                  @map("term_number") @db.SmallInt
  startsOn         DateTime             @map("starts_on") @db.Date
  endsOn           DateTime             @map("ends_on") @db.Date
  enrollmentStarts DateTime?            @map("enrollment_starts") @db.Timestamptz(3)
  enrollmentEnds   DateTime?            @map("enrollment_ends") @db.Timestamptz(3)
  status           AcademicPeriodStatus @default(PLANNED)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear           AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  applications           AdmissionApplication[]
  studentStatusEvents    StudentStatusHistory[]
  programAssignments     StudentProgramHistory[]
  enrollments            Enrollment[]
  classSections          ClassSection[]
  courseOfferings        CourseOffering[]
  gradingPeriods         GradingPeriod[]
  clearanceCycles        ClearanceCycle[]
  enrollmentApplications EnrollmentApplication[]
  enrollmentPeriods      EnrollmentPeriod[]
  assessments            Assessment[]
  financialEntries       FinancialTransaction[]
  studentObligations     StudentObligation[]

  @@unique([academicYearId, termNumber])
  @@index([status, startsOn])
  @@map("academic_terms")
}

/// Effective-dated snapshots preserve program changes without rewriting history.
model ProgramHistory {
  id              String    @id @default(uuid()) @db.Uuid
  programId       String    @map("program_id") @db.Uuid
  departmentId    String    @map("department_id") @db.Uuid
  version         Int
  code            String    @db.VarChar(32)
  name            String    @db.VarChar(200)
  credential      String    @db.VarChar(100)
  durationYears   Int       @map("duration_years") @db.SmallInt
  termsPerYear    Int       @map("terms_per_year") @db.SmallInt
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  changeReason    String?   @map("change_reason") @db.VarChar(500)
  changedByUserId String?   @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  program    Program    @relation(fields: [programId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  changedBy  User?      @relation("ProgramHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@unique([programId, version])
  @@index([programId, effectiveFrom, effectiveTo])
  @@index([departmentId])
  @@index([changedByUserId])
  @@map("program_history")
}

model ProgramHeadAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  programId        String    @map("program_id") @db.Uuid
  facultyId        String    @map("faculty_id") @db.Uuid
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  program    Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  faculty    Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  assignedBy User?   @relation("ProgramHeadAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([programId, startsOn, endsOn])
  @@index([facultyId, startsOn, endsOn])
  @@index([assignedByUserId])
  @@map("program_head_assignments")
}

/// Direct ownership assignment for role-based program accounts. Existing
/// faculty program-head assignments remain valid for legacy accounts.
model UserProgramAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  programId        String   @map("program_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program    Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  assignedBy User?   @relation("UserProgramAssignmentCreatedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@index([programId])
  @@index([assignedByUserId])
  @@map("user_program_assignments")
}

/// Department assignment for Student Assistant accounts.
model UserDepartmentAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  departmentId     String   @map("department_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedBy User?      @relation("UserDepartmentAssignmentCreatedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@index([departmentId])
  @@index([assignedByUserId])
  @@map("user_department_assignments")
}

/// College assignment for Dean accounts.
model UserCollegeAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  collegeId        String   @map("college_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college    College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  assignedBy User?   @relation("UserCollegeAssignmentCreatedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@index([collegeId])
  @@index([assignedByUserId])
  @@map("user_college_assignments")
}

model AdmissionApplication {
  id                          String                     @id @default(uuid()) @db.Uuid
  applicationNumber           String                     @map("application_number") @db.VarChar(40)
  applicationNumberNormalized String                     @unique @map("application_number_normalized") @db.VarChar(40)
  applicantUserId             String?                    @map("applicant_user_id") @db.Uuid
  intendedProgramId           String                     @map("intended_program_id") @db.Uuid
  academicTermId              String                     @map("academic_term_id") @db.Uuid
  convertedStudentId          String?                    @map("converted_student_id") @db.Uuid
  firstName                   String                     @map("first_name") @db.VarChar(100)
  middleName                  String?                    @map("middle_name") @db.VarChar(100)
  lastName                    String                     @map("last_name") @db.VarChar(100)
  suffix                      String?                    @db.VarChar(20)
  birthDate                   DateTime?                  @map("birth_date") @db.Date
  email                       String                     @db.VarChar(254)
  phone                       String?                    @db.VarChar(32)
  status                      AdmissionApplicationStatus @default(DRAFT)
  submittedAt                 DateTime?                  @map("submitted_at") @db.Timestamptz(3)
  decidedAt                   DateTime?                  @map("decided_at") @db.Timestamptz(3)
  decisionByUserId            String?                    @map("decision_by_user_id") @db.Uuid
  decisionNotes               String?                    @map("decision_notes") @db.Text
  metadata                    Json                       @default("{}") @db.JsonB
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  attemptNumber               Int                        @default(1) @map("attempt_number")

  applicant       User?                               @relation("ApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: SetNull)
  intendedProgram Program                             @relation(fields: [intendedProgramId], references: [id], onDelete: Restrict)
  academicTerm    AcademicTerm                        @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  student         Student?                            @relation(fields: [convertedStudentId], references: [id], onDelete: Restrict)
  decidedBy       User?                               @relation("ApplicationDecisionMaker", fields: [decisionByUserId], references: [id], onDelete: SetNull)
  history         AdmissionApplicationStatusHistory[]
  documents       StudentDocument[]

  @@index([applicantUserId, status])
  @@index([intendedProgramId, academicTermId, status])
  @@index([convertedStudentId])
  @@index([decisionByUserId])
  @@map("admission_applications")
}

model StudentDocument {
  id                     String  @id @default(uuid()) @db.Uuid
  studentId              String  @map("student_id") @db.Uuid
  admissionApplicationId String? @map("admission_application_id") @db.Uuid
  documentTypeId         String  @map("document_type_id") @db.Uuid

  originalFileName String @map("original_file_name") @db.VarChar(255)
  storedFileName   String @map("stored_file_name") @db.VarChar(255)
  filePath         String @map("file_path") @db.VarChar(500)
  fileSize         BigInt @map("file_size") @db.BigInt
  mimeType         String @map("mime_type") @db.VarChar(100)

  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt       DateTime @map("uploaded_at") @db.Timestamptz(3)

  status           StudentDocumentStatus @default(PENDING)
  verifiedByUserId String?               @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime?             @map("verified_at") @db.Timestamptz(3)
  remarks          String?               @db.Text
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  student              Student                       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  admissionApplication AdmissionApplication?         @relation(fields: [admissionApplicationId], references: [id], onDelete: Restrict)
  documentType         DocumentType                  @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  uploadedBy           User                          @relation("StudentDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  verifiedBy           User?                         @relation("StudentDocumentVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verificationHistory  DocumentVerificationHistory[]
  academicRecordImports AcademicRecordImportRequest[]

  @@unique([admissionApplicationId, documentTypeId])
  @@index([admissionApplicationId, status])
  @@index([studentId, status])
  @@index([status, uploadedAt])
  @@index([verifiedByUserId])
  @@map("student_documents")
}

model AdmissionApplicationStatusHistory {
  id              String                      @id @default(uuid()) @db.Uuid
  applicationId   String                      @map("application_id") @db.Uuid
  fromStatus      AdmissionApplicationStatus? @map("from_status")
  toStatus        AdmissionApplicationStatus  @map("to_status")
  actionType      String                      @map("action_type") @db.VarChar(50)
  changedByRole   String?                     @map("changed_by_role") @db.VarChar(64)
  remarks         String?                     @db.Text
  changedByUserId String?                     @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime                    @default(now()) @map("changed_at") @db.Timestamptz(3)

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  changedBy   User?                @relation("ApplicationStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, changedAt])
  @@index([applicationId, actionType, changedAt(sort: Desc)], map: "admission_application_history_action_changed_idx")
  @@index([changedByUserId])
  @@map("admission_application_status_history")
}

model StudentProgramHistory {
  id               String    @id @default(uuid()) @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  programId        String    @map("program_id") @db.Uuid
  academicTermId   String?   @map("academic_term_id") @db.Uuid
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  reason           String?   @db.VarChar(500)
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  program      Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  assignedBy   User?         @relation("StudentProgramAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId, startsOn, endsOn])
  @@index([programId, startsOn])
  @@index([academicTermId])
  @@index([assignedByUserId])
  @@map("student_program_history")
}

model StudentCurriculumAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  curriculumId     String    @map("curriculum_id") @db.Uuid
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  reason           String?   @db.VarChar(500)
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  assignedBy User?      @relation("StudentCurriculumAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId, startsOn, endsOn])
  @@index([curriculumId, startsOn])
  @@index([assignedByUserId])
  @@map("student_curriculum_assignments")
}

model StudentStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  studentId       String         @map("student_id") @db.Uuid
  academicTermId  String?        @map("academic_term_id") @db.Uuid
  fromStatus      StudentStatus? @map("from_status")
  toStatus        StudentStatus  @map("to_status")
  reason          String?        @db.VarChar(500)
  changedByUserId String?        @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  changedBy    User?         @relation("StudentStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId, changedAt])
  @@index([academicTermId, toStatus])
  @@index([changedByUserId])
  @@map("student_status_history")
}

model FacultyDepartmentAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  facultyId        String    @map("faculty_id") @db.Uuid
  departmentId     String    @map("department_id") @db.Uuid
  isPrimary        Boolean   @default(false) @map("is_primary")
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
