  reviewedByUserId   String?                     @map("reviewed_by_user_id") @db.Uuid
  reviewedAt         DateTime?                   @map("reviewed_at") @db.Timestamptz(3)
  importedAt         DateTime?                   @map("imported_at") @db.Timestamptz(3)
  importBatchId      String?                     @map("import_batch_id") @db.VarChar(64)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  student       Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  targetProgram Program         @relation("AcademicRecordImportTargetProgram", fields: [targetProgramId], references: [id], onDelete: Restrict)
  document      StudentDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  reviewedBy    User?           @relation("AcademicRecordImportReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([studentId, status])
  @@index([targetProgramId])
  @@index([status, createdAt])
  @@index([reviewedByUserId])
  @@map("academic_record_import_requests")
}

