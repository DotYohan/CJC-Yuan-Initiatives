# PostgreSQL connection (REQUIRED)
# For Neon: Use the Pooled connection string for DATABASE_URL
DATABASE_URL="postgresql://user:password@ep-cool-project-pooler.region.aws.neon.tech/neondb?sslmode=require"
# For Neon: Use the Direct (unpooled) connection string for DIRECT_URL (used for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-cool-project.region.aws.neon.tech/neondb?sslmode=require"

# Application environment
NODE_ENV=development
APP_ORIGIN=https://cjc-yuan-initiatives.onrender.com

# Security (production requires HTTPS and strong secrets)
CJC_AUDIT_PEPPER="replace-with-a-long-random-production-secret-at-least-32-chars"

# Optional: Document storage path
# CJC_DOCUMENT_ROOT=data/student-documents

# Optional: request duration at which an API warning is recorded
# CJC_SLOW_REQUEST_MS=1000

# Optional: Scrypt tuning (test uses weaker defaults)
# CJC_SCRYPT_N=131072
# CJC_SCRYPT_R=8
# CJC_SCRYPT_P=1

# Gemini AI (for AI-Assisted Academic Record Import / OCR)
# GEMINI_API_KEY="replace-with-your-gemini-api-key"
# GEMINI_MODEL="gemini-3.5-flash-lite"
