# Copy this file to .env for local development. Node 24 loads it directly.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://cjc_app:replace-me@localhost:5432/cor_jesu_sms?schema=public

# Required in production. Use at least 32 random bytes and keep it private.
# Production startup rejects the unchanged public placeholder below.
CJC_AUDIT_PEPPER=replace-with-a-long-random-production-secret

# Optional authentication hardening overrides (safe defaults are built in).
# CJC_CHANGE_PASSWORD_USER_LIMIT=5
# CJC_CHANGE_PASSWORD_IP_LIMIT=20
# CJC_CHANGE_PASSWORD_WINDOW_MS=900000
# CJC_CLEANUP_INTERVAL_MS=300000
# CJC_CLEANUP_BATCH_SIZE=250
# CJC_REVOKED_SESSION_RETENTION_MS=86400000
# CJC_USED_RESET_TOKEN_RETENTION_MS=86400000
# CJC_AUTH_HISTORY_RETENTION_MS=2592000000

# Optional. If omitted, `npm run seed:demo` generates a different password
# for every demo account and prints each password once.
# CJC_DEMO_PASSWORD=
